{
  "name": "rebrew",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "A cafe for better AI answers",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test:ui": "node tests/gesture.mjs",
    "app:build:windows": "tauri build --bundles nsis",
    "app:build:mac": "tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "^1.57.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  }
}
